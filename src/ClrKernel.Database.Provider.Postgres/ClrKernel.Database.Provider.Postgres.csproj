<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Database.Provider.Postgres</RootNamespace>
    <PackageId>ClrKernel.Database.Provider.Postgres</PackageId>
    <Description>PostgreSQL provider for ClrKernel: connect to PostgreSQL from C# notebook cells with the same fluent query API as the other providers — Postgres.Connect(host, port, database, user, "secret:ref").Query(sql).Results(). Built on Npgsql. Passwords are never written into a notebook or a config file; only a secret reference is, resolved from the OS credential store or CLRKERNEL_SECRET_*.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,PostgreSQL,Postgres,Npgsql,Database,dotnet,CLR</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Database/ClrKernel.Database.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClrKernel.Core.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Language.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Database.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Studio.UnitTest" />
  </ItemGroup>

  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
