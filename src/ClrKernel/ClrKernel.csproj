<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClrKernel</RootNamespace>
    <AssemblyName>ClrKernel</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clrkernel</ToolCommandName>
    <PackageId>ClrKernel</PackageId>
    <Description>Multi-language .NET Jupyter kernel. C# cells evaluated with Roslyn scripting; runs interactively and headlessly (nbconvert/papermill). Fork of SciSharp/ICSharpCore.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,C#,CSharp,dotnet,CLR,Roslyn</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3" />
    <PackageReference Include="NetMQ" Version="4.0.2.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Core/ClrKernel.Core.csproj" />
    <ProjectReference Include="../ClrKernel.Primitives/ClrKernel.Primitives.csproj" />
  </ItemGroup>
  <!-- this will include the kernel spec in the nuget pkg, reference properly -->
  <ItemGroup>
    <Content Include="kernel-spec/**/*">
      <Pack>true</Pack>
      <PackagePath>tools/any/kernel-spec/</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
 
</Project>
