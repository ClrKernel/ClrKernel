<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Core.Secrets</RootNamespace>
    <PackageId>ClrKernel.Core.Secrets</PackageId>
    <Description>Secret-free credential handling for ClrKernel: an ordered provider chain that resolves named secrets from the OS-native credential store (macOS Keychain, Windows Credential Manager, Linux libsecret) with an environment-variable fallback for headless runs. Passwords never live in a notebook or a config file — only opaque secret references do. Extensible with an enterprise PAM / vault by implementing ISecretProvider.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,Secrets,Credentials,Keychain,dotnet,CLR</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
