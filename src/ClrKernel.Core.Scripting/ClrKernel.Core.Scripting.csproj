<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Core.Scripting</RootNamespace>
    <PackageId>ClrKernel.Core.Scripting</PackageId>
    <Description>Execution core for ClrKernel: Roslyn C# scripting engine with #r nuget resolution, #!import/#!lib document loading (.dib, .ipynb, .csx), and display primitives — independent of any notebook transport (Jupyter, VS Code, CLI runners).</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,C#,CSharp,dotnet,CLR,Roslyn,Scripting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dotnet.Script.DependencyModel" Version="2.0.1" />
    <PackageReference Include="Dotnet.Script.DependencyModel.NuGet" Version="2.0.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.6.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- Direct references to lift vulnerable transitive dependencies. Still
         required as of Dotnet.Script 2.0.1: its NuGet.ProjectModel 6.14.3 chain
         (and even NuGet.Packaging 7.6.0 itself) resolves the vulnerable
         System.Security.Cryptography.Xml 8.0.2 (8x NU1903 high) without these.
         NuGet.* 7.x verified runtime-compatible: warm- and cold-cache
         #r nuget resolution both pass. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="NuGet.Packaging" Version="7.6.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Core.Primitives/ClrKernel.Core.Primitives.csproj" />
  </ItemGroup>

  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
