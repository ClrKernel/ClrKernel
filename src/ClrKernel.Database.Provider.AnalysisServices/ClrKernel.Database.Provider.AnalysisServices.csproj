<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Database.Provider.AnalysisServices</RootNamespace>
    <PackageId>ClrKernel.Database.Provider.AnalysisServices</PackageId>
    <Description>SQL Server Analysis Services (Tabular) provider for ClrKernel: connect to a semantic model, query it with DAX/DMV, read table &amp; partition metadata, recalculate, process partitions/tables/models, and add or remove partitions — from C# notebook cells via the `Ssas` helper. Works against on-premises SSAS (Windows auth), Azure Analysis Services, and Microsoft Fabric / Power BI semantic models (Entra auth). Built on the Tabular Object Model (AMO) and ADOMD.NET. The `#!dax` cell language lives in ClrKernel.Language.Dax.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,SSAS,AnalysisServices,Tabular,Fabric,PowerBI,dotnet,CLR</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices.AdomdClient" Version="19.114.8" />
    <PackageReference Include="Microsoft.AnalysisServices.NetCore.retail.amd64" Version="19.84.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Core.Primitives/ClrKernel.Core.Primitives.csproj" />
    <ProjectReference Include="../ClrKernel.Database/ClrKernel.Database.csproj" />
    <ProjectReference Include="../ClrKernel.Database.Entra/ClrKernel.Database.Entra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClrKernel.Language.Dax" />
    <InternalsVisibleTo Include="ClrKernel.Core.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Language.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Database.UnitTest" />
  </ItemGroup>

  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
