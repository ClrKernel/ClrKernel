<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Fabric</RootNamespace>
    <PackageId>ClrKernel.Fabric</PackageId>
    <Description>Microsoft Fabric warehouse helpers for ClrKernel: from C# notebook cells, connect to a Fabric Warehouse SQL endpoint (Microsoft Entra auth), run T-SQL, and bulk-insert query results into warehouse tables by staging Parquet to OneLake and loading with OPENROWSET. Includes a reload-batch helper (delete a segment, reload it, run a batch of tables in parallel). Built on Microsoft.Fabric.Api, Azure.Storage.Files.DataLake, Parquet.Net, and Microsoft.Data.SqlClient.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,Fabric,Warehouse,OneLake,Parquet,dotnet,CLR</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Fabric.Api" Version="1.0.0" />
    <PackageReference Include="Azure.Storage.Files.DataLake" Version="12.21.0" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Parquet.Net" Version="5.2.0" />
    <!-- Pin the latest patched Snappier: Parquet.Net 5.2.0 pulls 1.1.6 transitively,
         which has NU1903 advisory GHSA-pggp-6c3x-2xmx. (Parquet.Net 6.x drops the
         schema-based serializer overload FabricParquet relies on, so we stay on 5.x.) -->
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Primitives/ClrKernel.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClrKernel.UnitTest" />
  </ItemGroup>

  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
