<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Language.Python</RootNamespace>
    <PackageId>ClrKernel.Language.Python</PackageId>
    <Description>Python cells for ClrKernel: runs `#!python` cells in a resident interpreter per notebook, so names bound in one cell are there in the next, with output streamed as it happens. Uses an interpreter you point it at (CLRKERNEL_PYTHON), one the kernel has provisioned, or whatever is on PATH.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,Python,dotnet,CLR</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The driver travels inside the assembly: this package is also loaded by
         `#r "nuget: …"` into a running session, where there is no content
         directory beside the dll to read from. -->
    <EmbeddedResource Include="driver.py" LogicalName="ClrKernel.Language.Python.driver.py" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Core.Scripting/ClrKernel.Core.Scripting.csproj" />
    <ProjectReference Include="../ClrKernel.Core.Primitives/ClrKernel.Core.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
