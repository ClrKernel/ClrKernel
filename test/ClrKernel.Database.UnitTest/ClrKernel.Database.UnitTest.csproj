<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>ClrKernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <!-- Pin the patched native SQLite: Microsoft.Data.Sqlite pulls
         SQLitePCLRaw.lib.e_sqlite3 2.1.10, still under NU1903 advisory
         GHSA-2m69-gcr7-jv3q; 2.1.12 is the fixed build. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!-- Language.Sql / Language.Dax are here because several provider tests drive a real cell
       (SqlServer.Connection(...) or AnalysisServices.Connect(...) inside #!csharp), which needs
       the language registered. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ClrKernel.Core.Scripting\ClrKernel.Core.Scripting.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Core.Primitives\ClrKernel.Core.Primitives.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Formatting.Html\ClrKernel.Formatting.Html.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Core.Secrets\ClrKernel.Core.Secrets.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database\ClrKernel.Database.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Entra\ClrKernel.Database.Entra.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.DataEngineering\ClrKernel.DataEngineering.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Provider.SqlServer\ClrKernel.Database.Provider.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Provider.AnalysisServices\ClrKernel.Database.Provider.AnalysisServices.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Provider.Fabric\ClrKernel.Database.Provider.Fabric.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Provider.Oracle\ClrKernel.Database.Provider.Oracle.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Provider.Odbc\ClrKernel.Database.Provider.Odbc.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Database.Provider.Postgres\ClrKernel.Database.Provider.Postgres.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Language.Sql\ClrKernel.Language.Sql.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Language.Dax\ClrKernel.Language.Dax.csproj" />
  </ItemGroup>

</Project>
