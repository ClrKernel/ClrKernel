<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Core.ExtensionServer</RootNamespace>
    <PackageId>ClrKernel.Core.ExtensionServer</PackageId>
    <Description>JSON-RPC-over-stdio notebook host for ClrKernel: executes C# cells via ClrKernel.Core.Scripting for editor integrations (VS Code notebooks) — no Python or Jupyter required. Hosted by the ClrKernel CLI (`clrkernel serve`) and embeddable by other clients.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Notebook,C#,CSharp,dotnet,CLR,Roslyn,VSCode,JSON-RPC</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Core.Scripting/ClrKernel.Core.Scripting.csproj" />
    <ProjectReference Include="../ClrKernel.Core.LanguageServices/ClrKernel.Core.LanguageServices.csproj" />
    <ProjectReference Include="../ClrKernel.Core.Primitives/ClrKernel.Core.Primitives.csproj" />
    <!--
      Documented exception to the Core.* -> Language.* layering rule (HANDOFF-17
      section 4.2, amended in P3). Needed ONLY for the connection-management
      RPCs the VS Code extension calls (clrkernel/sql/*, clrkernel/dax/*), which
      are typed against the sessions' own APIs. Language *features* (completion,
      hover, signature help, diagnostics) must keep going through the cell
      language registry, never through these references.
    -->
    <ProjectReference Include="../ClrKernel.Language.Sql/ClrKernel.Language.Sql.csproj" />
    <ProjectReference Include="../ClrKernel.AnalysisServices/ClrKernel.AnalysisServices.csproj" />
    <ProjectReference Include="../ClrKernel.Language.PowerShell/ClrKernel.Language.PowerShell.csproj" />
  </ItemGroup>

  <!-- nuget.org gallery assets -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
