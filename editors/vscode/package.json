{
  "name": "clrkernel-notebooks",
  "displayName": "ClrKernel Notebooks",
  "description": "Run C#, HTTP, Mermaid, PowerShell, SQL, and DAX notebooks \u2014 including executable markdown \u2014 on ClrKernel. No Python, no Jupyter.",
  "version": "0.8.0",
  "publisher": "clrkernel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClrKernel/ClrKernel"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "notebooks": [
      {
        "type": "clrkernel-markdown",
        "displayName": "ClrKernel Markdown Notebook",
        "selector": [
          {
            "filenamePattern": "*.nb.md"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "csharp-script",
        "aliases": [
          "C#",
          "C# Script",
          "csharp-script"
        ],
        "extensions": [
          ".cs",
          ".csx"
        ],
        "icon": {
          "light": "./images/csharp2.svg",
          "dark": "./images/csharp2.svg"
        },
        "configuration": "./language-configuration.csharp.json"
      },
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "icon": {
          "light": "./images/http.svg",
          "dark": "./images/http.svg"
        },
        "configuration": "./language-configuration.http.json"
      },
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid",
          "mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "icon": {
          "light": "./images/mermaid.svg",
          "dark": "./images/mermaid.svg"
        },
        "configuration": "./language-configuration.mermaid.json"
      },
      {
        "id": "dax",
        "aliases": [
          "DAX",
          "dax"
        ],
        "extensions": [
          ".dax"
        ],
        "icon": {
          "light": "./images/dax.svg",
          "dark": "./images/dax.svg"
        },
        "configuration": "./language-configuration.dax.json"
      },
      {
        "id": "clr-oraclesql",
        "aliases": [
          "Oracle SQL",
          "oraclesql",
          "plsql"
        ],
        "extensions": [
          ".oraclesql",
          ".sql"
        ],
        "icon": {
          "light": "./images/plsql.svg",
          "dark": "./images/plsql.svg"
        },
        "configuration": "./language-configuration.sql-dialect.json"
      },
      {
        "id": "clr-ansisql",
        "aliases": [
          "SQL (Generic)",
          "ansisql"
        ],
        "extensions": [
          ".ansisql",
          ".sql"
        ],
        "icon": {
          "light": "./images/sql-light.svg",
          "dark": "./images/sql-dark.svg"
        },
        "configuration": "./language-configuration.sql-dialect.json"
      },
      {
        "id": "clr-sql",
        "aliases": [
          "T-SQL",
          "clr-sql"
        ],
        "extensions": [
          ".tsql",
          ".sql"
        ],
        "icon": {
          "light": "./images/tsql-icon.svg",
          "dark": "./images/tsql-icon.svg"
        },
        "configuration": "./language-configuration.sql-dialect.json"
      }
    ],
    "grammars": [
      {
        "language": "csharp-script",
        "scopeName": "source.clrkernel-cs",
        "path": "./syntaxes/clrkernel-csharp.tmLanguage.json"
      },
      {
        "language": "http",
        "scopeName": "source.http",
        "path": "./syntaxes/http.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      },
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      },
      {
        "language": "dax",
        "scopeName": "source.dax",
        "path": "./syntaxes/dax.tmLanguage.json"
      },
      {
        "language": "clr-oraclesql",
        "scopeName": "source.oraclesql",
        "path": "./syntaxes/oraclesql.tmLanguage.json"
      },
      {
        "language": "clr-ansisql",
        "scopeName": "source.ansisql",
        "path": "./syntaxes/ansisql.tmLanguage.json"
      },
      {
        "language": "clr-sql",
        "scopeName": "source.clr-sql",
        "path": "./syntaxes/clr-sql.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "ClrKernel",
      "properties": {
        "clrkernel.server.command": {
          "type": "string",
          "default": "clrkernel",
          "description": "Command that launches the ClrKernel language server. The default uses the ClrKernel global dotnet tool ('clrkernel lsp'), which serves both execution and language features (completion, hover, signature help). Set to 'dotnet' and point args at a locally built ClrKernel.dll to use a dev build."
        },
        "clrkernel.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the server command. Defaults to ['lsp']. For a dev build set command to 'dotnet' and args to ['<path>/ClrKernel.dll', 'lsp']."
        },
        "clrkernel.stopOnCellError": {
          "type": "boolean",
          "default": true,
          "description": "When running multiple cells (e.g. Run All), stop at the first cell that errors instead of continuing. Matches the headless command-line runner and Jupyter's nbconvert. Set to false to run every selected cell regardless of failures."
        }
      }
    },
    "configurationDefaults": {
      "workbench.editorAssociations": {
        "*.nb.md": "clrkernel-markdown"
      }
    },
    "commands": [
      {
        "command": "clrkernel.newNotebook",
        "title": "New Markdown Notebook",
        "shortTitle": "Markdown Notebook",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.sql.selectConnection",
        "title": "SQL: Select Connection for Cell",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.sql.addConnection",
        "title": "SQL: Add Connection\u2026",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.sql.editConnection",
        "title": "SQL: Edit Connection\u2026",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.dax.selectConnection",
        "title": "DAX: Select Cube for Cell",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.dax.addConnection",
        "title": "DAX: Add Cube\u2026",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.dax.editConnection",
        "title": "DAX: Edit Cube\u2026",
        "category": "ClrKernel"
      },
      {
        "command": "clrkernel.restartKernel",
        "title": "Restart Kernel",
        "shortTitle": "Restart",
        "category": "ClrKernel",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "clrkernel.newNotebook",
          "group": "notebook"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "clrkernel.restartKernel",
          "when": "notebookType == clrkernel-markdown",
          "group": "navigation/execute@5"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "bundle:dev": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "package": "vsce package",
    "changelog": "node scripts/changelog.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "vscode-languageclient": "^9.0.1"
  },
  "icon": "images/icon.png",
  "keywords": [
    "csharp",
    "c#",
    "notebook",
    "jupyter",
    "repl",
    "markdown",
    "dotnet",
    "roslyn",
    "interactive",
    "http",
    "rest",
    "sql",
    "dax",
    "database",
    "powershell",
    "mermaid"
  ],
  "bugs": {
    "url": "https://github.com/ClrKernel/ClrKernel/issues"
  },
  "homepage": "https://github.com/ClrKernel/ClrKernel"
}
