<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ClrKernel.Database.Provider.SqlServer</RootNamespace>
    <PackageId>ClrKernel.Database.Provider.SqlServer</PackageId>
    <Description>Microsoft SQL Server provider for ClrKernel: named, secret-free connections (Integrated Security, SQL login, or Microsoft Entra — passwords resolve from the OS credential store, never from committed files), a fluent query API over Microsoft.Data.SqlClient, SqlBulkCopy-backed bulk loads with create-from-schema, MERGE generation, and T-SQL deployment helpers (CREATE OR ALTER rewriting, GO batch splitting). Used by the #!sql cell language in ClrKernel.Language.Sql and directly from C# cells.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,SQL,SqlServer,TSQL,BulkCopy,dotnet,CLR</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ClrKernel.Core.Primitives/ClrKernel.Core.Primitives.csproj" />
    <ProjectReference Include="../ClrKernel.Core.Secrets/ClrKernel.Core.Secrets.csproj" />
    <ProjectReference Include="../ClrKernel.Database/ClrKernel.Database.csproj" />
    <ProjectReference Include="../ClrKernel.DataEngineering/ClrKernel.DataEngineering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClrKernel.Language.Sql" />
    <InternalsVisibleTo Include="ClrKernel.Core.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Language.UnitTest" />
    <InternalsVisibleTo Include="ClrKernel.Database.UnitTest" />
  </ItemGroup>

  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
