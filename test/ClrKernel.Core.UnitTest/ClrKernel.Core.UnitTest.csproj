<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>ClrKernel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <!-- The engine, primitives, headless runner and C# language services. Deliberately references
       NO Language.* package: CellLanguageRegistry.Default is Empty until something registers, so
       these tests exercise C# cells with no #! languages present at all. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ClrKernel.Core.Scripting\ClrKernel.Core.Scripting.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Core.Primitives\ClrKernel.Core.Primitives.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Formatting.Html\ClrKernel.Formatting.Html.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Core.Runner\ClrKernel.Core.Runner.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Core.LanguageServices\ClrKernel.Core.LanguageServices.csproj" />
    <ProjectReference Include="..\..\src\ClrKernel.Core.ExtensionServer\ClrKernel.Core.ExtensionServer.csproj" />
  </ItemGroup>

  <!-- The shipped notebooks are the round-trip corpus: NotebookMarkdownTest asserts every
       one survives Parse → Serialize byte for byte, so the web editor's save can never
       rewrite a file it didn't mean to change. -->
  <ItemGroup>
    <None Include="..\..\samples\*.nb.md" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
