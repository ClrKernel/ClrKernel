<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Ref assembly on, though the SDK leaves it off for netstandard2.0. Roslyn's
         MSBuildWorkspace matches each ProjectReference to the compiler's metadata
         reference, which is the ref assembly where one exists; with TargetRefPath
         empty there is nothing to match, so every load warned "Found project
         reference without a matching metadata reference" and referencing projects
         got this assembly as a plain dll instead of a live project reference. -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <!-- Records on netstandard2.0: the compiler supports them anywhere, it only
         needs IsExternalInit (shimmed in Compat/IsExternalInit.cs). -->
    <LangVersion>latest</LangVersion>
    <PackageId>ClrKernel.Core.Primitives</PackageId>
    <Description>Jupyter messaging primitives for ClrKernel (a .NET Jupyter kernel): display-data types and emitters for producing rich MIME output from notebook cells.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,C#,CSharp,dotnet,CLR,DisplayData</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
  </PropertyGroup>
  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../ClrKernel/kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
