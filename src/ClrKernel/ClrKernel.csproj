<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClrKernel</RootNamespace>
    <AssemblyName>ClrKernel</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>clrkernel</ToolCommandName>
    <PackageId>ClrKernel</PackageId>
    <Description>Multi-language .NET notebook CLI. One tool, three modes: `clrkernel jupyter` (Jupyter kernel), `clrkernel serve` (stdio JSON-RPC server for the VS Code extension), and `clrkernel run` (headless .nb.md/.dib/.ipynb runner with papermill-style parameters). C# cells evaluated with Roslyn scripting. Fork of SciSharp/ICSharpCore.</Description>
    <Copyright>Copyright © ClrKernel contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo-64x64.png</PackageIcon>
    <PackageProjectUrl>https://github.com/ClrKernel/ClrKernel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ClrKernel/ClrKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Jupyter,Notebook,Kernel,C#,CSharp,dotnet,CLR,Roslyn,papermill,VSCode</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- The three execution modes. Core + Primitives arrive transitively. -->
    <ProjectReference Include="../ClrKernel.Core.JupyterKernel/ClrKernel.Core.JupyterKernel.csproj" />
    <ProjectReference Include="../ClrKernel.Core.ExtensionServer/ClrKernel.Core.ExtensionServer.csproj" />
    <ProjectReference Include="../ClrKernel.Core.Runner/ClrKernel.Core.Runner.csproj" />
  </ItemGroup>
  <!-- this will include the kernel spec in the nuget pkg, reference properly -->
  <ItemGroup>
    <Content Include="kernel-spec/**/*">
      <Pack>true</Pack>
      <PackagePath>tools/any/kernel-spec/</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- nuget.org gallery assets: README rendered on the package page, icon in listings -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="kernel-spec/logo-64x64.png" Pack="true" PackagePath="/" />
  </ItemGroup>
 
</Project>
